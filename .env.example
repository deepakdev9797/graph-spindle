# GraphSpindle environment (sanitized example). Copy to .env and fill in; never commit .env.
# Every variable is optional unless marked REQUIRED; the defaults are those of application.yml.

# --- Server and security ----------------------------------------------------------------------
# Bind address. 127.0.0.1 (default) = local only. Any other address REQUIRES the admin key below.
GRAPHSPINDLE_BIND_ADDRESS=127.0.0.1
GRAPHSPINDLE_PORT=8080
# Bootstrap admin API key, at least 32 random characters, e.g. `openssl rand -base64 32`.
# REQUIRED off loopback and for Docker Compose. Only its hash is kept in memory; never logged.
GRAPHSPINDLE_ADMIN_API_KEY=
# false = no authentication (every request acts as the admin); refused unless bound to loopback
GRAPHSPINDLE_SECURITY_ENABLED=true
# Swagger UI and /v3/api-docs: AUTO (open on loopback, key required otherwise) | PUBLIC | AUTHENTICATED
GRAPHSPINDLE_API_DOCS_ACCESS=AUTO
# DNS-rebinding protection: accepted Host headers / browser Origins, comma-separated ("host:*" = any port)
GRAPHSPINDLE_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*
GRAPHSPINDLE_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://[::1]:*,https://localhost:*,https://127.0.0.1:*,https://[::1]:*
# In-memory rate limits per principal (requests, ingestions) and per client address (invalid keys), per minute
GRAPHSPINDLE_RATE_LIMIT_REQUESTS=300
GRAPHSPINDLE_RATE_LIMIT_INGEST=30
GRAPHSPINDLE_RATE_LIMIT_FAILED_AUTH=20
# Request body cap in bytes
GRAPHSPINDLE_MAX_REQUEST_BYTES=1048576

# --- Neo4j ------------------------------------------------------------------------------------
GRAPHSPINDLE_NEO4J_URI=bolt://localhost:7687
GRAPHSPINDLE_NEO4J_USERNAME=neo4j
# REQUIRED for Docker Compose (also sets the Neo4j container's password). Empty = no auth (local dev only).
GRAPHSPINDLE_NEO4J_PASSWORD=

# --- LLM provider -----------------------------------------------------------------------------
# ollama | openai (also OpenAI-compatible servers) | anthropic | none (ingestion answers 503)
GRAPHSPINDLE_LLM_PROVIDER=none
GRAPHSPINDLE_LLM_ENABLED=true
# optional per-call model override (empty = the provider's model below)
GRAPHSPINDLE_LLM_MODEL=
# AUTO (provider JSON schema for Ollama, schema only in the prompt for remote providers) | PROVIDER_SCHEMA | PROMPT
GRAPHSPINDLE_LLM_STRUCTURED_OUTPUT=AUTO
GRAPHSPINDLE_LLM_CONTEXT_TOKENS=32768
GRAPHSPINDLE_LLM_MAX_OUTPUT_TOKENS=4096
GRAPHSPINDLE_LLM_SEED=42
GRAPHSPINDLE_LLM_CALL_TIMEOUT=90s
GRAPHSPINDLE_LLM_TIMEOUT=120s
GRAPHSPINDLE_LLM_HTTP_READ_TIMEOUT=95s

# Ollama (local; with the compose "ollama" profile use http://ollama:11434)
GRAPHSPINDLE_OLLAMA_BASE_URL=http://localhost:11434
GRAPHSPINDLE_OLLAMA_MODEL=gemma4:12b

# OpenAI or an OpenAI-compatible server (LM Studio, vLLM, llama.cpp, Groq ...): include /v1.
# Remote providers receive the ingested content.
GRAPHSPINDLE_OPENAI_BASE_URL=https://api.openai.com/v1
GRAPHSPINDLE_OPENAI_API_KEY=
GRAPHSPINDLE_OPENAI_MODEL=gpt-4.1-mini

# Anthropic (remote: receives the ingested content)
GRAPHSPINDLE_ANTHROPIC_API_KEY=
GRAPHSPINDLE_ANTHROPIC_MODEL=claude-sonnet-5-5

# --- MCP --------------------------------------------------------------------------------------
GRAPHSPINDLE_MCP_REQUEST_TIMEOUT=150s
GRAPHSPINDLE_MCP_SESSION_IDLE_TIMEOUT=30m
GRAPHSPINDLE_MCP_MAX_SESSIONS=1000

# --- Vocabulary -------------------------------------------------------------------------------
# optional YAML merged over the bundled core vocabulary, e.g. file:/etc/graphspindle/vocabulary.yml
GRAPHSPINDLE_VOCABULARY_LOCATION=
# false = vocabulary API read-only (403 on writes)
GRAPHSPINDLE_VOCABULARY_API_MUTABLE=true
